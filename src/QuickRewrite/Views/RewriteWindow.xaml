<Window x:Class="QuickRewrite.Views.RewriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="338" Height="292" MinWidth="338" MinHeight="292"
        Icon="pack://application:,,,/QuickRewrite;component/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundBrush}"
        ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ModeChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" CornerRadius="8"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="6,1,4,0"
                  Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Image Width="16" Height="16" VerticalAlignment="Center"
                           Source="pack://application:,,,/QuickRewrite;component/Assets/app-128.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="文本改写" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <Button Content="×" Style="{StaticResource CaptionButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click" ToolTip="关闭" />
            </Grid>
            <!-- 小型模式工具条 -->
            <ScrollViewer Grid.Row="1" Margin="12,2,12,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ModeList" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ModeChipStyle}"
                                         GroupName="RewriteModeChips"
                                         Tag="{Binding}"
                                         AutomationProperties.Name="{Binding Title}"
                                         Checked="Mode_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontSize="10"
                                               Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 自定义要求只在原位置展开一行 -->
            <Border x:Name="CustomPanel" Grid.Row="2" Margin="12,5,12,0"
                    Background="{DynamicResource ControlFillBrush}" CornerRadius="7"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    Padding="7,5" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstructionBox"
                             Style="{StaticResource RoundedTextBoxStyle}"
                             Height="30" Padding="8,4" FontSize="11.5"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="InstructionBox_PreviewKeyDown" />
                    <Button Grid.Column="1" Content="开始" Style="{StaticResource PrimaryButtonStyle}"
                            Height="30" MinHeight="30" Padding="10,4" Margin="6,0,0,0"
                            Click="CustomSubmit_Click" />
                </Grid>
            </Border>

            <!-- 固定双栏工作区 -->
            <Grid Grid.Row="3" Margin="12,7,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource EditorSurfaceBrush}"
                        CornerRadius="8" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="10,0,7,0">
                            <TextBlock Text="原文" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="OriginalCount" FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                            <TextBox x:Name="OriginalText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     Padding="10,8" FontSize="11.5"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource EditorSurfaceBrush}"
                        CornerRadius="8" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="10,0,7,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="改写结果" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="ModeLabel" FontSize="9"
                                           Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ResultCount" FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                                <TextBox x:Name="ResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         Padding="10,8" FontSize="11.5"
                                         Visibility="Collapsed"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                            </Border>

                            <Border x:Name="EmptyStatePanel" Background="Transparent">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="132">
                                    <Border Width="32" Height="32" CornerRadius="16"
                                            Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="✦" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="选择上方的改写方式" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="生成结果会直接显示在这里，原文始终保留在左侧。"
                                               FontSize="9" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="LoadingOverlay" Background="{DynamicResource LoadingLayerBrush}"
                                    Visibility="Collapsed">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="LoadingGlow" Width="78" Height="78" CornerRadius="39"
                                            BorderThickness="3" Opacity="0.55">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                <GradientStop Color="#FFFF9F0A" Offset="0" />
                                                <GradientStop Color="#FFFF375F" Offset="0.1" />
                                                <GradientStop Color="#FFBF5AF2" Offset="0.2" />
                                                <GradientStop Color="#FF0A84FF" Offset="0.3" />
                                                <GradientStop Color="#FF30D5C8" Offset="0.4" />
                                                <GradientStop Color="#FFFF9F0A" Offset="0.5" />
                                                <LinearGradientBrush.RelativeTransform>
                                                    <TransformGroup>
                                                        <TranslateTransform x:Name="RainbowGlowShift" />
                                                        <RotateTransform x:Name="RainbowGlowSpin"
                                                                         CenterX="0.5" CenterY="0.5" />
                                                    </TransformGroup>
                                                </LinearGradientBrush.RelativeTransform>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Effect>
                                            <BlurEffect Radius="6" />
                                        </Border.Effect>
                                    </Border>

                                    <Border x:Name="LoadingPill" Width="76" Height="76" CornerRadius="38"
                                            Background="{DynamicResource EditorSurfaceBrush}"
                                            BorderThickness="1.6">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                <GradientStop Color="#FFFF9F0A" Offset="0" />
                                                <GradientStop Color="#FFFF375F" Offset="0.1" />
                                                <GradientStop Color="#FFBF5AF2" Offset="0.2" />
                                                <GradientStop Color="#FF0A84FF" Offset="0.3" />
                                                <GradientStop Color="#FF30D5C8" Offset="0.4" />
                                                <GradientStop Color="#FFFF9F0A" Offset="0.5" />
                                                <LinearGradientBrush.RelativeTransform>
                                                    <TransformGroup>
                                                        <TranslateTransform x:Name="RainbowShift" />
                                                        <RotateTransform x:Name="RainbowSpin"
                                                                         CenterX="0.5" CenterY="0.5" />
                                                    </TransformGroup>
                                                </LinearGradientBrush.RelativeTransform>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                              Opacity="0.16" Color="#FF8E8E93" />
                                        </Border.Effect>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="正在改写" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="LoadingStatus" Text="理解原文…" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="ErrorPanel" Background="{DynamicResource LoadingLayerBrush}"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="138" Margin="8">
                                    <TextBlock Text="这次改写没有完成" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center"
                                               FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                    <Button Content="重试" Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Center" Margin="0,8,0,0"
                                            Height="28" MinHeight="28" Padding="10,4"
                                            Click="Regenerate_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 固定操作栏 -->
            <Grid Grid.Row="4" Margin="12,0,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Text="请选择一个改写方式。"
                           FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button x:Name="RegenerateButton" Content="重新生成" Style="{StaticResource BaseButtonStyle}"
                            Height="30" MinHeight="30" Padding="9,4" FontSize="10.5"
                            IsEnabled="False" Click="Regenerate_Click" />
                    <Button x:Name="CopyButton" Content="复制结果" Style="{StaticResource BaseButtonStyle}"
                            Height="30" MinHeight="30" Padding="9,4" FontSize="10.5" Margin="5,0,0,0"
                            IsEnabled="False" Click="Copy_Click" />
                    <Button x:Name="ReplaceButton" Content="确认改写" Style="{StaticResource PrimaryButtonStyle}"
                            Height="30" MinHeight="30" Padding="10,4" FontSize="10.5" Margin="5,0,0,0"
                            IsEnabled="False" Click="Replace_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
